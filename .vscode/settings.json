{
  "editor.fontWeight": "500",
  "editor.formatOnSave": false,
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "window.zoomLevel": 0.9,
  "editor.fontFamily": "'FiraCode Nerd Font', 'JetBrainsMono Nerd Font', 'FiraMono Nerd Font Propo', 'JetBrains Mono', 'MesloLGL Nerd Font Mono'",
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font', 'FiraMono Nerd Font Propo', 'JetBrains Mono', 'JetBrainsMono Nerd Font'",
  "editor.lineHeight": 3,
  "editor.rulers": [100],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "tailwindCSS.validate": true,
  "[html,php]": {
    "editor.tabSize": 4,
  },
  "[html]": {
    "editor.formatOnSave": false,
  },
  "[shellscript]": {
    "editor.tabSize": 4,
    "files.eol": "\n",
    "editor.defaultColorDecorators": "never",
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "explorer.fileNesting.enabled": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "apphosting.yaml": "apphosting.*.yaml,storage.rules,firestore.rules,.firebaserc,firestore-*",
    "package.json": ".eslint*,.prettier*,*.json,*.jsonl,biome.*,.gitignore,.npmrc,tsconfig*,pnpm-*,bun.lockb,nest*,*.setup.ts,*.setup.js,*.config.ts,*.nvmrc,*.config.js,components.json,turbo.json,next-env.d.ts,*.config.cjs,*.config.mjs,*.lock,*-lock.json,*.properties,*.toml,*.jsonc",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "editor.renderLineHighlight": "gutter",
  "workbench.editor.labelFormat": "short",
  "editor.semanticHighlighting.enabled": false,
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "hidden",
  "editor.hideCursorInOverviewRuler": true,
  "explorer.sortOrder": "foldersNestsFiles",
  "css.validate": false,
  "editor.accessibilitySupport": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.largeFileOptimizations": false,
  "editor.renderWhitespace": "all",
  "editor.showUnused": true,
  "files.trimTrailingWhitespace": true,
  "html.autoClosingTags": true,
  "html.format.templating": true,
  "less.validate": false,
  "scss.validate": false,
  "typescript.suggest.autoImports": true,
  "files.exclude": {
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/node_modules/**": true,
    "**/firebase-export-*/**": true,
    "**/emulator-data/**": true,
    "**/chrome-debug-profile/**": true,
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
  },
  "search.exclude": {
    "/tmp/**": true,
    "**/out": true,
    "**/build": true,
    "**/dist": true,
    "**/__*": true,
    "**/*.lock": true,
    "**/*.next": true,
    ".temp": true,
    "temp": true,
    ".tmp": true,
    "tmp": true,
    "**/*.min.*": true,
    "**/bower": true,
    "**/.tmp": true,
    "**/_bower": true,
    "**/_site": true,
    "**/dev": true,
    "**/local": true,
    "**/prod": true,
    "**/.nuxt": true,
    "**/.next": true,
    "**/wp-admin": true,
    "**/wp-includes": true,
    "**/node_modules": true,
    "**/node_modules/**": true,
    "**/coverage": true,
    "**/.vercel": true,
    "**/.husky/_": true,
    "**/.sass-cache": true,
    "**/__mocks__": false,
  },
  "files.watcherExclude": {
    "**/chrome-debug-profile/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules/**/*",
    "**/*.min.*",
    "**/*.bundle*",
    "**/*.map",
    "**/dist/**/*",
    "**/build/**/*",
    "**/ios/**/*",
    "**/android/**/*",
    "**/__tests__/**/*",
    "node_modules",
    "dist",
  ],
  "files.associations": {
    "*.tsx": "typescriptreact",
    ".env.*": "dotenv",
    ".prettierrc": "json",
    "*.lock": "plaintext",
  },
  "editor.parameterHints.enabled": false,
  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.suggestSelection": "first",
  "explorer.confirmDelete": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.prettier": "always",
    "source.organizeImports.prettier": "always",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
  },
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.tsserver.log": "off",
  "emmet.syntaxProfiles": {
    "javascript": "jsx",
  },
  "breadcrumbs.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "workbench.editor.empty.hint": "hidden",
  "workbench.startupEditor": "none",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "scm.showActionButton": false,
  "scm.showInputActionButton": false,
  "workbench.editor.editorActionsLocation": "titleBar",
  "zenMode.showTabs": "none",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.cursorStyleInactive": "underline",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop",
  ],
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.env.linux": {
    "NODE_ENV": "development",
  },
  "terminal.integrated.automationProfile.linux": {
    "path": "/usr/bin/zsh",
    "args": ["--login", "--interactive"],
  },
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/usr/bin/zsh",
      "args": ["-l"],
    },
  },
  "gitblame.inlineMessageEnabled": true,
  "gitblame.inlineMessageFormat": "Author: ${author.name} - ${time.ago}",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "git.defaultBranchName": "dev",
  "git.enableCommitSigning": true,
  "git.useEditorAsCommitInput": true,
  "git.verboseCommit": false,
  "git.allowNoVerifyCommit": true,
  "git.autofetch": true,
  "editor.linkedEditing": true,
  "1password.editor.suggestStorage": false,
  "editor.wordBasedSuggestions": "off",
  "git.ignoreLimitWarning": true,
  "workbench.colorCustomizations": {},
  "diffEditor.ignoreTrimWhitespace": true,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.view.showQuietly": {
    "workbench.panel.output": false,
  },
  "errorLens.statusBarColorsEnabled": true,
  "json.schemaDownload.enable": true,
  "diffEditor.maxComputationTime": 0,
  "markdown.preview.openMarkdownLinks": "inEditor",
  "markdownlint.run": "onSave",
  "markdownlint.config": {
    "MD040": false,
    "MD051": false,
    "MD013": false,
    "MD056": false,
    "MD024": false,
    "MD034": false,
    "MD060": false,
    "MD036": false,
    "MD041": false,
    "MD033": false,
    "MD057": false,
  },
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.tabWidth": 2,
  "mermaid.vscode.dark": "dark",
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "redhat.telemetry.enabled": true,
  "markdown-preview-enhanced.previewTheme": "vscode.css",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.hideOnboarding": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "diffEditor.hideUnchangedRegions.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "editor.minimap.showSlider": "always",
  "editor.minimap.renderCharacters": false,
  "scm.inputFontSize": 12,
  "chat.fontSize": 12,
  "chat.editor.fontSize": 12,
  "debug.console.fontSize": 12,
  "workbench.browser.showInTitleBar": false,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://spec.openapis.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://raw.githubusercontent.com": true,
    "https://biomejs.dev": true,
  },
  "chat.disableAIFeatures": true,
  "workbench.openInAgents.enabled": false,
  "window.autoDetectColorScheme": false,
  "workbench.agentsWindowButton.enabled": false,
  "editor.minimap.enabled": false,
  "zenMode.centerLayout": false,
  "zenMode.silentNotifications": false,
  "cursor.composer.conversationDensity": "detailed",
  "cursor.general.glassShowWarningNotifications": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "git.showCommitInput": false,
  "accessibility.signals.chatResponseReceived": {
    "sound": "off",
  },
  "accessibility.signals.chatUserActionRequired": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off",
  },
  "accessibility.signals.chatRequestSent": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.clear": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off",
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off",
  },
  "biome.suggestInstallingGlobally": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "workbench.editor.enablePreview": false,
  "workbench.layoutControl.enabled": false,
  "window.menuBarVisibility": "toggle",
  "workbench.productIconTheme": "icons-carbon",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.colorTheme": "Terminal Noir",
}
