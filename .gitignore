# Local-only planning documents (specs, plans, state, reviews) never leave this computer.
# The whole directory is ignored, with no exceptions.
/docs/

# Private overlay and secrets
# private/ is the default location of the private overlay: everything in it is ignored
# except the two public documents that describe it.
/private/*
!/private/README.md
!/private/private-overlay.md
.env*
*.local
*.bak
tests/.tmp/

# Real profile identity files stay local; examples remain tracked.
profiles/**/git-*.conf
!profiles/**/git-*.conf.example
profiles/**/gcloud-*.conf
!profiles/**/gcloud-*.conf.example
profiles/.current
profiles/.current-*
