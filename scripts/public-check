#!/usr/bin/env bash
# Fail when tracked (or staged) files contain personal data or forbidden paths.
set -eo pipefail

STAGED=0
TARGET="."

while [ "$#" -gt 0 ]; do
    case "$1" in
        --staged) STAGED=1; shift ;;
        -h|--help)
            printf '%s\n' "Usage: public-check [--staged] [path]"
            exit 0
            ;;
        --) shift; break ;;
        -*)
            printf '%s\n' "public-check: unknown option: $1" >&2
            exit 2
            ;;
        *) TARGET="$1"; shift; break ;;
    esac
done

if [ "$#" -gt 0 ]; then
    printf '%s\n' "public-check: unexpected arguments: $*" >&2
    exit 2
fi

TARGET="$(cd "$TARGET" && pwd)"
ALLOW_FILE="$TARGET/scripts/public-check.allow"
FINDINGS=0

# Load email and credit allowlist entries from scripts/public-check.allow
ALLOWED_EMAILS=()
ALLOWED_CREDITS=()
if [ -f "$ALLOW_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|\#*) continue ;;
            email:*)
                ALLOWED_EMAILS+=("${line#email:}")
                ;;
            credit:*)
                ALLOWED_CREDITS+=("${line#credit:}")
                ;;
        esac
    done < "$ALLOW_FILE"
fi

email_allowed() {
    local addr="$1" entry
    case "$addr" in
        *@users.noreply.github.com) return 0 ;;
        *@example.com|*@example.org|*@example.net) return 0 ;;
        git@*) return 0 ;;
    esac
    for entry in "${ALLOWED_EMAILS[@]+"${ALLOWED_EMAILS[@]}"}"; do
        if [ "$addr" = "$entry" ]; then
            return 0
        fi
    done
    return 1
}

# credit:<file>:<exact line text> — author name allowed only on that exact line.
credit_allowed() {
    local rel="$1" text="$2" entry
    for entry in "${ALLOWED_CREDITS[@]+"${ALLOWED_CREDITS[@]}"}"; do
        if [ "$entry" = "${rel}:${text}" ]; then
            return 0
        fi
    done
    return 1
}

report() {
    # file:line: reason
    printf '%s\n' "$1:$2: $3"
    FINDINGS=1
}

path_forbidden() {
    local rel="$1"
    case "$rel" in
        private/README.md|private/private-overlay.md) return 1 ;;
        private|private/*) return 0 ;;
        .env|.env.*|*/.env|*/.env.*) return 0 ;;
        *.pem) return 0 ;;
        id_rsa|id_rsa.*|*/id_rsa|*/id_rsa.*) return 0 ;;
        docs|docs/*) return 0 ;;
    esac
    return 1
}

is_binary() {
    # grep -I exits 0 on text, 1 on binary/no match; treat binary as skip.
    ! grep -Iq '' "$1" 2>/dev/null
}

list_files() {
    if [ "$STAGED" -eq 1 ]; then
        git -C "$TARGET" diff --cached --name-only -z --diff-filter=ACMR
    else
        git -C "$TARGET" ls-files -z
    fi
}

scan_file() {
    local rel="$1"
    local abs="$TARGET/$rel"

    case "$rel" in
        tests/bats/lib|tests/bats/lib/*) return 0 ;;
        scripts/public-check.allow) return 0 ;;
    esac

    if path_forbidden "$rel"; then
        report "$rel" "1" "forbidden path"
        return 0
    fi

    [ -f "$abs" ] || return 0
    if is_binary "$abs"; then
        return 0
    fi

    # One grep per pattern per file (not per line): line numbers come from -n.
    scan_pattern "$rel" "$abs" 'cpf' '\b[0-9]{3}\.[0-9]{3}\.[0-9]{3}-[0-9]{2}\b'
    scan_pattern "$rel" "$abs" 'cnpj' '\b[0-9]{2}\.[0-9]{3}\.[0-9]{3}/[0-9]{4}-[0-9]{2}\b'
    scan_pattern "$rel" "$abs" 'phone' '\(?[0-9]{2}\)?[ -]?9?[0-9]{4}-[0-9]{4}'
    scan_pattern "$rel" "$abs" 'whatsapp link' 'wa\.me/55[0-9]{10,11}'
    # Private IPv4: 10/8, 172.16/12, 192.168/16, 100.64/10
    scan_pattern "$rel" "$abs" 'private ipv4' '\b10\.([0-9]{1,3}\.){2}[0-9]{1,3}\b'
    scan_pattern "$rel" "$abs" 'private ipv4' '\b172\.(1[6-9]|2[0-9]|3[0-1])\.([0-9]{1,3}\.)[0-9]{1,3}\b'
    scan_pattern "$rel" "$abs" 'private ipv4' '\b192\.168\.([0-9]{1,3}\.)[0-9]{1,3}\b'
    scan_pattern "$rel" "$abs" 'private ipv4' '\b100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.([0-9]{1,3}\.)[0-9]{1,3}\b'
    scan_pattern "$rel" "$abs" 'home path' '/home/[A-Za-z]'
    scan_pattern "$rel" "$abs" 'home path' '/Users/[A-Za-z]'

    # E-mails: catch common forms, allow documentation and allowfile entries.
    local hit line_no addr text
    while IFS= read -r hit; do
        line_no="${hit%%:*}"
        addr="${hit#*:}"
        if ! email_allowed "$addr"; then
            report "$rel" "$line_no" "personal e-mail"
        fi
    done < <(grep -noE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' "$abs" || true)

    # Author handle / site: only exact allowlisted credit lines may name it.
    # Built at runtime so this source line is not itself a finding.
    # Word boundaries keep the GitHub user nandomoreirame from matching.
    local author_re="nando""moreira"
    while IFS= read -r hit; do
        line_no="${hit%%:*}"
        text="${hit#*:}"
        if ! credit_allowed "$rel" "$text"; then
            report "$rel" "$line_no" "author credit"
        fi
    done < <(grep -niE "\\b${author_re}\\b" "$abs" || true)
}

# scan_pattern <rel> <abs> <reason> <ERE>: report each matching line once.
scan_pattern() {
    local hit
    while IFS= read -r hit; do
        report "$1" "${hit%%:*}" "$3"
    done < <(grep -nE -- "$4" "$2" || true)
}

while IFS= read -r -d '' rel || [ -n "$rel" ]; do
    [ -n "$rel" ] || continue
    scan_file "$rel"
done < <(list_files)

# gitleaks when available (optional dependency)
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks_out="$(mktemp)"
    set +e
    gitleaks detect --no-git --source "$TARGET" --no-banner >"$gitleaks_out" 2>&1
    gitleaks_rc=$?
    set -e
    if [ "$gitleaks_rc" -ne 0 ]; then
        cat "$gitleaks_out"
        FINDINGS=1
    fi
    rm -f "$gitleaks_out"
fi

if [ "$FINDINGS" -ne 0 ]; then
    exit 1
fi

printf '%s\n' "public-check: ok"
exit 0
