                "selection.background": $e.selection,
                "textLink.foreground": $e.primary,
                "textLink.activeForeground": $e.warning,
                "button.background": $e.primary,
                "button.foreground": $e.primaryForeground,
                "button.hoverBackground": $e.warning,
                "button.secondaryBackground": $e.surfaceElevated,
                "button.secondaryForeground": $e.foreground,
                "badge.background": $e.primary,
                "badge.foreground": $e.primaryForeground,
                "progressBar.background": $e.primary,
                "input.background": $e.surface,
                "input.border": $e.borderStrong,
                "input.foreground": $e.foreground,
