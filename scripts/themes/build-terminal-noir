                "scrollbarSlider.background": ($e.borderStrong + "66"),
                "scrollbarSlider.hoverBackground": ($e.borderStrong + "99"),
                "scrollbarSlider.activeBackground": ($e.borderStrong + "CC"),
                "widget.shadow": "#00000080",
                "editor.background": $e.background,
