# TextMate theme (plist) read by bat. Scopes are joined with ", ".
build_bat() {
    local dir="$OUT_ROOT/configs/bat/themes"
    mkdir -p "$dir"

    jq -r '
        def kv($k; $v): "\t\t\t\t<key>\($k)</key>\n\t\t\t\t<string>\($v)</string>";
        .editor as $e
        | [
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
            "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">",
            "<!-- Generated by scripts/themes/build-terminal-noir; edit configs/themes/terminal-noir/syntax.json. -->",
            "<plist version=\"1.0\">",
            "<dict>",
            "\t<key>name</key>",
            "\t<string>Terminal Noir</string>",
            "\t<key>settings</key>",
            "\t<array>",
            "\t\t<dict>",
            "\t\t\t<key>settings</key>",
            "\t\t\t<dict>",
            kv("background"; $e.background),
            kv("foreground"; $e.foreground),
            kv("caret"; $e.primary),
            kv("selection"; $e.selection),
            kv("lineHighlight"; $e.surface),
            kv("gutter"; $e.background),
            kv("gutterForeground"; $e.lineNumber),
            "\t\t\t</dict>",
            "\t\t</dict>",
            (.tokens[] | (
                "\t\t<dict>",
                "\t\t\t<key>name</key>",
                "\t\t\t<string>\(.name)</string>",
                "\t\t\t<key>scope</key>",
                "\t\t\t<string>\(.scope | join(", "))</string>",
                "\t\t\t<key>settings</key>",
                "\t\t\t<dict>",
                (if .color then kv("foreground"; .color) else empty end),
                (if .fontStyle then kv("fontStyle"; .fontStyle) else empty end),
                "\t\t\t</dict>",
                "\t\t</dict>"
            )),
            "\t</array>",
            "</dict>",
            "</plist>"
          ]
        | .[]' "$SYNTAX" > "$dir/Terminal Noir.tmTheme"
}

build_ghostty() {
    local dir="$OUT_ROOT/configs/ghostty/themes" mode
    mkdir -p "$dir"

    for mode in dark light; do
        {
            printf '# Terminal Noir (%s), from nandomoreira.dev.\n' "$mode"
            printf '# Source of truth: configs/noctalia/palettes/Terminal Noir.json (.%s.terminal).\n\n' "$mode"
            jq -r --arg m "$mode" '
                .[$m].terminal as $t
                | ["black","red","green","yellow","blue","magenta","cyan","white"] as $n
                | ([range(0; 8) as $i | "palette = \($i)=\($t.normal[$n[$i]])"]
                   + [range(0; 8) as $i | "palette = \($i + 8)=\($t.bright[$n[$i]])"]
                   + ["background = \($t.background)",
                      "foreground = \($t.foreground)",
                      "cursor-color = \($t.cursor)",
                      "cursor-text = \($t.cursorText)",
                      "selection-background = \($t.selectionBg)",
                      "selection-foreground = \($t.selectionFg)"])
                | .[] | ascii_downcase' "$PALETTE"
        } > "$dir/terminal-noir-$mode"
    done
}

# Micro colorscheme. Token colors reuse the syntax roles of syntax.json, picked
# by name; chrome (gutter, status line, cursor line) uses the editor block.
build_micro() {
    local dir="$OUT_ROOT/configs/micro/colorschemes"
    mkdir -p "$dir"

    jq -r '
        def tok($n): (.tokens[] | select(.name == $n) | .color);
        .editor as $e
        | [
            "# Terminal Noir, from nandomoreira.dev.",
            "# Generated by scripts/themes/build-terminal-noir; edit configs/themes/terminal-noir/syntax.json.",
            "",
            "color-link default \"\($e.foreground),\($e.background)\"",
            "color-link comment \"italic \(tok("Comment"))\"",
            "",
            "color-link identifier \"\(tok("Function"))\"",
            "color-link identifier.class \"\(tok("Type"))\"",
            "color-link identifier.var \"\(tok("Variable"))\"",
            "",
            "color-link constant \"\(tok("Number and constant"))\"",
            "color-link constant.number \"\(tok("Number and constant"))\"",
            "color-link constant.string \"\(tok("String"))\"",
            "color-link constant.specialChar \"\(tok("Regex and escape"))\"",
            "",
            "color-link symbol \"\(tok("Operator"))\"",
            "color-link symbol.brackets \"\(tok("Operator"))\"",
            "color-link symbol.tag \"\(tok("Tag"))\"",
            "",
            "color-link type \"\(tok("Type"))\"",
            "color-link type.keyword \"\(tok("Keyword"))\"",
            "color-link type.extended \"default\"",
            "",
            "color-link special \"\(tok("Property"))\"",
            "color-link statement \"\(tok("Keyword"))\"",
            "color-link preproc \"\(tok("Attribute"))\"",
            "",
            "color-link underlined \"underline \($e.info)\"",
            "color-link error \"bold \($e.error)\"",
            "color-link todo \"bold \($e.warning)\"",
            "",
            "color-link diff-added \"\($e.success)\"",
            "color-link diff-modified \"\($e.warning)\"",
            "color-link diff-deleted \"\($e.error)\"",
            "",
            "color-link gutter-error \"\($e.error)\"",
            "color-link gutter-warning \"\($e.warning)\"",
            "",
            "color-link statusline \"\($e.muted),\($e.surface)\"",
            "color-link tabbar \"\($e.muted),\($e.surface)\"",
            "color-link indent-char \"\($e.borderStrong)\"",
            "color-link line-number \"\($e.lineNumber)\"",
            "color-link current-line-number \"\($e.primary)\"",
            "",
            "color-link cursor-line \"\($e.surfaceElevated),\($e.foreground)\"",
            "color-link color-column \"\($e.surfaceElevated)\""
          ]
        | .[]' "$SYNTAX" > "$dir/terminal-noir.micro"
}

build_vscode
build_bat
build_ghostty
build_micro
