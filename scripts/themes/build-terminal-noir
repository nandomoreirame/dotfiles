#!/usr/bin/env bash
# build-terminal-noir — Generate the Terminal Noir themes that are not driven
# by Noctalia templates, from two sources of truth:
#   configs/noctalia/palettes/Terminal Noir.json  (palette, incl. terminal ANSI)
#   configs/themes/terminal-noir/syntax.json      (editor chrome + syntax scopes)
#
# Outputs (relative to OUT_ROOT, default: the repo root):
#   configs/vscode/terminal-noir/package.json + themes/terminal-noir-color-theme.json
#   configs/bat/themes/Terminal Noir.tmTheme
#   configs/ghostty/themes/terminal-noir-{dark,light}
#   configs/micro/colorschemes/terminal-noir.micro
#
# tests/unit/configs/terminal-noir-themes.bats fails when the committed files
# drift from a fresh build, so rerun this after editing either source.
#
# Usage: build-terminal-noir [--out DIR] [OUT_ROOT]
# --out DIR and a positional OUT_ROOT both mirror the repo layout into that directory.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
readonly REPO_ROOT
readonly PALETTE="$REPO_ROOT/configs/noctalia/palettes/Terminal Noir.json"
readonly SYNTAX="$REPO_ROOT/configs/themes/terminal-noir/syntax.json"

OUT_ROOT="$REPO_ROOT"
while [ "$#" -gt 0 ]; do
    case "$1" in
        --out)
            [ "$#" -ge 2 ] || { printf '%s\n' "build-terminal-noir: --out needs a directory" >&2; exit 2; }
            OUT_ROOT="$2"
            shift 2
            ;;
        -h|--help)
            printf '%s\n' "Usage: build-terminal-noir [--out DIR] [OUT_ROOT]"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf '%s\n' "build-terminal-noir: unknown option: $1" >&2
            exit 2
            ;;
        *)
            OUT_ROOT="$1"
            shift
            break
            ;;
    esac
done
readonly OUT_ROOT

build_vscode() {
