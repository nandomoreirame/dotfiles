                "editorCursor.foreground": $e.primary,
                "editor.lineHighlightBackground": $e.surface,
                "editor.lineHighlightBorder": $e.surface,
                "editor.selectionBackground": ($e.selection + "99"),
                "editor.inactiveSelectionBackground": ($e.selection + "55"),
                "editor.selectionHighlightBackground": ($e.selection + "55"),
                "editor.wordHighlightBackground": ($e.selection + "55"),
                "editor.findMatchBackground": ($e.primary + "66"),
                "editor.findMatchHighlightBackground": ($e.primary + "33"),
