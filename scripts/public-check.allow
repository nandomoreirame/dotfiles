# Allowlist for scripts/public-check.
# One entry per line. Blank lines and # comments are ignored.
#
# email:<address>   permit that exact e-mail address in tracked files
# credit:<file>:<line text>   permit that exact line (author credit in theme files)
#
# Example (do not commit real personal addresses):
# email:owner@example.com

# Terminal Noir theme credit lines (exact match)
credit:configs/themes/terminal-noir/syntax.json:  "_comment": "Terminal Noir syntax colors (dark), from nandomoreira.dev. Colors come from configs/noctalia/palettes/Terminal Noir.json; the ANSI bright hues fill the roles the site does not define. Edit here, then run scripts/themes/build-terminal-noir.",
credit:configs/vscode/terminal-noir/package.json:  "description": "Terminal Noir palette from nandomoreira.dev. Generated by scripts/themes/build-terminal-noir.",
credit:configs/vscode/terminal-noir/package.json:  "publisher": "nandomoreira",
credit:configs/ghostty/themes/terminal-noir-dark:# Terminal Noir (dark), from nandomoreira.dev.
credit:configs/ghostty/themes/terminal-noir-light:# Terminal Noir (light), from nandomoreira.dev.
credit:configs/micro/colorschemes/terminal-noir.micro:# Terminal Noir, from nandomoreira.dev.
credit:scripts/themes/install-terminal-noir-editors:    <Identity Language="en-US" Id="terminal-noir" Version="$version" Publisher="nandomoreira"/>
credit:scripts/themes/install-terminal-noir-editors:    <Description xml:space="preserve">Terminal Noir palette from nandomoreira.dev.</Description>
credit:scripts/themes/build-terminal-noir-icons:Comment=Adwaita with amber folders (Terminal Noir, nandomoreira.dev)
credit:scripts/themes/build-terminal-noir:        description: "Terminal Noir palette from nandomoreira.dev. Generated by scripts/themes/build-terminal-noir.",
credit:scripts/themes/build-terminal-noir:        publisher: "nandomoreira",
credit:scripts/themes/build-terminal-noir:            printf '# Terminal Noir (%s), from nandomoreira.dev.\n' "$mode"
credit:scripts/themes/build-terminal-noir:            "# Terminal Noir, from nandomoreira.dev.",
