#!/usr/bin/env bash
set -euo pipefail

# webapp-browser - Resolve which Chromium-family browser opens web apps.
#
# One resolver for the CLI side, mirroring lib/browser.luau in the Noctalia
# webappbar plugin. Order: $WEBAPP_BROWSER, ~/.config/webappbar/browser,
# xdg-settings default, preference order, chromium.
#
# Usage:
#   webapp-browser --get          print the logical binary that will be used
#   webapp-browser --exec         print the real executable (maps the logical
#                                 name through the .desktop Exec line when the
#                                 name is not on PATH, e.g. google-chrome ->
#                                 /usr/bin/google-chrome-stable)
#   webapp-browser --id           print the matching Chromium desktop id
#   webapp-browser --list         print the installed Chromium desktop ids
#   webapp-browser set <id|path>  store the choice in ~/.config/webappbar/browser
#   webapp-browser -h | --help

# Preference order shared with the plugin.
FAMILIES=(google-chrome chromium brave-browser vivaldi-stable microsoft-edge opera)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/webappbar"
CONFIG_FILE="$CONFIG_DIR/browser"

show_help() {
  sed -n '4,/^$/s/^# \?//p' "$0"
  exit 0
}

# Map any accepted spelling to a known Chromium binary name.
bin_for_id() {
  case "${1:-}" in
    google-chrome | google-chrome-stable | chrome) echo google-chrome ;;
    chromium | chromium-browser | ungoogled-chromium) echo chromium ;;
    brave | brave-browser) echo brave-browser ;;
    vivaldi | vivaldi-stable) echo vivaldi-stable ;;
    microsoft-edge | msedge) echo microsoft-edge ;;
    opera) echo opera ;;
    *) return 1 ;;
  esac
}

# Known name -> a stored value may also be an absolute binary path.
bin_for_value() {
  local value="$1"
  [[ -z "$value" ]] && return 1
  if bin_for_id "${value%.desktop}" >/dev/null 2>&1; then
    bin_for_id "${value%.desktop}"
  elif [[ "$value" == /* ]]; then
    echo "$value"
  else
    return 1
  fi
}

xdg_default_id() {
  command -v xdg-settings >/dev/null 2>&1 || return 1
  xdg-settings get default-web-browser 2>/dev/null || return 1
}

# Installed = a .desktop found in the XDG application data dirs:
# $XDG_DATA_HOME (default ~/.local/share) plus every $XDG_DATA_DIRS entry,
# defaulting to the XDG spec's /usr/local/share:/usr/share when unset.
installed_ids() {
  local id dir
  local -a data_dirs=("${XDG_DATA_HOME:-$HOME/.local/share}")
  local -a sys_dirs=()
  IFS=: read -r -a sys_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  data_dirs+=("${sys_dirs[@]}")
  for id in "${FAMILIES[@]}"; do
    for dir in "${data_dirs[@]}"; do
      if [[ -f "$dir/applications/$id.desktop" ]]; then
        echo "$id"
        break
      fi
    done
  done
}

resolve() {
  local value id
  if [[ -n "${WEBAPP_BROWSER:-}" ]] && value="$(bin_for_value "$WEBAPP_BROWSER")"; then
    echo "$value"
    return 0
  fi
  if [[ -r "$CONFIG_FILE" ]]; then
    read -r value <"$CONFIG_FILE" || true
    if value="$(bin_for_value "$value")"; then
      echo "$value"
      return 0
    fi
  fi
  if id="$(xdg_default_id)" && value="$(bin_for_value "$id")"; then
    echo "$value"
    return 0
  fi
  id="$(installed_ids | head -1)"
  if [[ -n "$id" ]] && value="$(bin_for_id "$id")"; then
    echo "$value"
    return 0
  fi
  echo chromium
}

# Every XDG application data dir, spec order (used by --exec to find a .desktop).
data_dirs() {
  local -a sys_dirs=()
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
  IFS=: read -r -a sys_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  printf '%s\n' "${sys_dirs[@]}"
}

# First argument of an Exec line, honouring one level of quoting.
exec_first_arg() {
  local line="$1"
  if [[ "$line" == \"* ]]; then
    line="${line#\"}"
    printf '%s' "${line%%\"*}"
  else
    printf '%s' "${line%% *}"
  fi
}

# Resolve the logical name to an executable that exists. The .desktop Exec line
# is the source of truth (google-chrome is often installed only as
# google-chrome-stable); mirrors browser_exec() in the plugin's service.luau.
resolve_exec() {
  local bin id dir line
  bin="$(resolve)"
  # An absolute custom path is used verbatim.
  if [[ "$bin" == /* ]]; then
    echo "$bin"
    return 0
  fi
  # The .desktop Exec line comes first: it carries machine overrides (a local
  # google-chrome.desktop may point at a wrapper), matching browser_exec().
  for id in "${FAMILIES[@]}"; do
    [[ "$(bin_for_id "$id")" == "$bin" ]] || continue
    while IFS= read -r dir; do
      [[ -r "$dir/applications/$id.desktop" ]] || continue
      line="$(sed -n 's/^Exec=//p' "$dir/applications/$id.desktop" | head -1)"
      [[ -z "$line" ]] && continue
      exec_first_arg "$line"
      return 0
    done < <(data_dirs)
  done
  # No .desktop: the name itself, when it exists on PATH, is the answer.
  if command -v "$bin" >/dev/null 2>&1; then
    echo "$bin"
    return 0
  fi
  # Nothing better found: the logical name is the best answer we have.
  echo "$bin"
}

case "${1:-}" in
  -h | --help) show_help ;;
  --get) resolve ;;
  --exec) resolve_exec ;;
  --id)
    bin="$(resolve)"
    for id in "${FAMILIES[@]}"; do
      if [[ "$(bin_for_id "$id")" == "$bin" ]]; then
        echo "$id"
        exit 0
      fi
    done
    echo "$bin"
    ;;
  --list) installed_ids ;;
  set)
    [[ -n "${2:-}" ]] || { echo "usage: webapp-browser set <id|path>" >&2; exit 2; }
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$2" > "$CONFIG_FILE"
    ;;
  *) echo "usage: webapp-browser [--get|--exec|--id|--list|set <id|path>]" >&2; exit 2 ;;
esac
