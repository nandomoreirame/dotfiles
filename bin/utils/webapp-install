#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib/spinner.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/spinner.sh"

# webapp-install - Create a .desktop launcher for a web app
#
# Wraps a website as a Chromium "app mode" window and registers it as a
# .desktop entry so it shows up in the Noctalia / app launcher. Ported from
# Omarchy's omarchy-webapp-install, adapted for Niri with zero extra deps
# (uses read instead of gum). The generated launcher calls webapp-launch by
# absolute path, so it works regardless of PATH in the graphical session.
#
# Usage:
#   webapp-install                                       (interactive)
#   webapp-install <name> <url> [icon] [custom-exec] [mime-types]
#   webapp-install --list
#   webapp-install -h | --help
#
# Arguments:
#   name         Display name (shown in the launcher)
#   url          Web app URL (https:// is added if no scheme is given)
#   icon         Optional PNG URL or local icon filename; favicon if omitted
#   custom-exec  Optional Exec command override
#   mime-types   Optional MimeType= value for the .desktop entry
#
# Examples:
#   webapp-install "YouTube Music" https://music.youtube.com
#   webapp-install Gmail mail.google.com https://dashboardicons.com/.../gmail.png
#   webapp-install            # prompts for name + URL, auto-fetches favicon

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[info]${NC}  $*"; }
ok()    { echo -e "${GREEN}[ok]${NC}    $*"; }
warn()  { echo -e "${YELLOW}[warn]${NC}  $*"; }
error() { echo -e "${RED}[error]${NC} $*" >&2; }

# --- Directories ---
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_DIR="$DESKTOP_DIR/icons"

# Absolute path to sibling helpers (webapp-browser / webapp-launch).
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# --- Help ---
show_help() {
  sed -n '4,/^$/s/^# \?//p' "$0"
  exit 0
}

# --- Resolve the browser once, so the Exec is self-contained ---
BROWSER_BIN=""
resolve_browser() {
  if [[ -z "$BROWSER_BIN" ]]; then
    BROWSER_BIN="$("$SCRIPT_DIR/webapp-browser" --exec 2>/dev/null || echo chromium)"
  fi
}

# --- List web apps: managed, legacy and Chrome-installed PWAs ---
list_webapps() {
  info "Web apps in $DESKTOP_DIR:"
  echo ""
  local found=false
  while IFS= read -r -d '' file; do
    local exec_line name id
    exec_line="$(sed -n 's/^Exec=//p' "$file" | head -1)"
    name="$(sed -n 's/^Name=//p' "$file" | head -1)"
    id="$(basename "${file%.desktop}")"
    [[ -z "$name" ]] && name="$id"
    if [[ -n "$(sed -n 's/^X-Webappbar-Id=//p' "$file" | head -1)" ]]; then
      found=true
      printf '  %b[webapp]%b %-24s %b%s%b\n' "$GREEN" "$NC" "$name" "$CYAN" "$exec_line" "$NC"
    elif [[ "$exec_line" == *webapp-launch* ]]; then
      found=true
      printf '  %b[legacy]%b %-24s %b%s%b\n' "$YELLOW" "$NC" "$name" "$CYAN" "$exec_line" "$NC"
    elif [[ "$exec_line" == *--app-id=* ]] &&
         { [[ "$exec_line" == *google-chrome* ]] || [[ "$exec_line" == *chromium* ]] || [[ "$exec_line" == *chrome* ]]; }; then
      found=true
      local appid="${exec_line##*--app-id=}"
      appid="${appid%% *}"
      printf '  %b[chrome]%b %-24s %bapp-id=%s%b\n' "$YELLOW" "$NC" "$name" "$CYAN" "$appid" "$NC"
    fi
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)
  if [[ "$found" == false ]]; then
    warn "No web apps found."
  else
    echo ""
    echo -e "  ${GREEN}[webapp]${NC} managed (this script / Noctalia webappbar)"
    echo -e "  ${YELLOW}[legacy]${NC} old webapp-launch entries - run the webappbar migration"
    echo -e "  ${YELLOW}[chrome]${NC} Chrome PWA - remove via chrome://apps (or migrate)"
  fi
  exit 0
}

# --- Normalize a URL by adding https:// when no scheme is present ---
normalize_url() {
  local u="$1"
  if [[ ! "$u" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    u="https://$u"
  fi
  echo "$u"
}

# --- Early flags ---
case "${1:-}" in
  -h | --help) show_help ;;
  --list) list_webapps ;;
esac

# --- Collect inputs (interactive when name/url are missing) ---
CUSTOM_EXEC=""
MIME_TYPES=""
ICON_REF=""

if (( $# < 2 )); then
  echo -e "${GREEN}Let's create a new web app you can start from the app launcher.${NC}\n"
  read -rp "Name> " APP_NAME
  read -rp "URL>  " APP_URL
  INTERACTIVE=true
else
  APP_NAME="$1"
  APP_URL="$2"
  ICON_REF="${3:-}"
  CUSTOM_EXEC="${4:-}"
  MIME_TYPES="${5:-}"
  INTERACTIVE=false
fi

if [[ -z "$APP_NAME" || -z "$APP_URL" ]]; then
  error "You must provide both an app name and a URL."
  exit 1
fi

# Reject path traversal / control chars in names used as file basenames.
if [[ "$APP_NAME" == .* || "$APP_NAME" == */* || "$APP_NAME" == *\\* || "$APP_NAME" =~ [[:cntrl:]] ]]; then
  error "Invalid app name: '$APP_NAME'"
  exit 1
fi

APP_URL="$(normalize_url "$APP_URL")"

mkdir -p "$ICON_DIR"

# --- Resolve the icon (favicon by default, PNG URL, or local filename) ---
ICON_PATH=""
if [[ -z "$ICON_REF" ]]; then
  # Try to auto-fetch a favicon.
  FAVICON_URL="https://www.google.com/s2/favicons?domain=${APP_URL}&sz=128"
  if spin_run "Fetching favicon" curl -fsL -o "$ICON_DIR/$APP_NAME.png" "$FAVICON_URL" >/dev/null 2>&1 && [[ -s "$ICON_DIR/$APP_NAME.png" ]]; then
    ICON_PATH="$ICON_DIR/$APP_NAME.png"
    ok "Favicon fetched automatically."
  elif [[ "$INTERACTIVE" == true ]]; then
    read -rp "Icon URL (PNG, see https://dashboardicons.com)> " ICON_REF
  fi
fi

if [[ -z "$ICON_PATH" && -n "$ICON_REF" ]]; then
  if [[ "$ICON_REF" =~ ^https?:// ]]; then
    ICON_PATH="$ICON_DIR/$APP_NAME.png"
    if ! spin_run "Downloading icon" curl -fsSL -o "$ICON_PATH" "$ICON_REF" || [[ ! -s "$ICON_PATH" ]]; then
      error "Failed to download icon from $ICON_REF"
      exit 1
    fi
  else
    if [[ "$ICON_REF" == .* || "$ICON_REF" == */* || "$ICON_REF" == *\\* || "$ICON_REF" == *..* || "$ICON_REF" =~ [[:cntrl:]] ]]; then
      error "Invalid icon reference: '$ICON_REF'"
      exit 1
    fi
    ICON_PATH="$ICON_DIR/$ICON_REF"
  fi
fi

# --- Build the .desktop entry (format shared with the Noctalia plugin) ---
# Escape one Exec argument the way the plugin's desktop.luau does (and the
# Desktop Entry spec requires): percent signs double, and \ " ` $ get a
# backslash. Only the Exec line is escaped; X-Webappbar-Url keeps the raw URL.
escape_exec_value() {
  local v="$1"
  v="${v//%/%%}"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  v="${v//\`/\\\`}"
  v="${v//\$/\\\$}"
  printf '%s' "$v"
}

resolve_browser
if [[ -n "$CUSTOM_EXEC" ]]; then
  EXEC_COMMAND="$CUSTOM_EXEC"
else
  EXEC_COMMAND="\"$(escape_exec_value "$BROWSER_BIN")\" --app=\"$(escape_exec_value "$APP_URL")\""
fi
DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"

mkdir -p "$DESKTOP_DIR"
{
  echo "[Desktop Entry]"
  echo "Version=1.0"
  echo "Name=$APP_NAME"
  echo "Comment=$APP_NAME (web app)"
  echo "Exec=$EXEC_COMMAND"
  echo "Terminal=false"
  echo "Type=Application"
  [[ -n "$ICON_PATH" ]] && echo "Icon=$ICON_PATH"
  echo "Categories=Network;WebApp;"
  echo "StartupNotify=true"
  [[ -n "$MIME_TYPES" ]] && echo "MimeType=$MIME_TYPES"
  echo "X-Webappbar-Id=$APP_NAME"
  echo "X-Webappbar-Url=$APP_URL"
  echo "X-Webappbar-Browser=$BROWSER_BIN"
} > "$DESKTOP_FILE"

chmod +x "$DESKTOP_FILE"
update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} Web app '${APP_NAME}' created!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "  Launch:    search '${APP_NAME}' in your app launcher"
echo "  Test now:  webapp-launch ${APP_URL}"
echo "  List apps: webapp-install --list"
echo "  Remove:    webapp-remove \"${APP_NAME}\""
echo ""
