#!/usr/bin/env bash
set -euo pipefail

# webapp-remove - Remove web app .desktop launchers created by webapp-install
#
# With no arguments, lists existing web apps and lets you pick one or more to
# remove via fzf (multi-select with TAB). With arguments, removes the named
# apps directly. Ported from Omarchy's omarchy-webapp-remove, adapted for Niri
# (uses fzf instead of gum, no walker restart).
#
# Usage:
#   webapp-remove                 (interactive multi-select via fzf)
#   webapp-remove <name>...       (remove the named web apps)
#   webapp-remove -h | --help
#
# Examples:
#   webapp-remove
#   webapp-remove "YouTube Music" Gmail

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()    { echo -e "${GREEN}[ok]${NC}    $*"; }
warn()  { echo -e "${YELLOW}[warn]${NC}  $*"; }
error() { echo -e "${RED}[error]${NC} $*" >&2; }

# --- Directories ---
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_DIR="$DESKTOP_DIR/icons"

# --- Help ---
show_help() {
  sed -n '4,/^$/s/^# \?//p' "$0"
  exit 0
}

# True if a Chrome PWA .desktop has Name == $1 (so we can warn instead of fail).
chrome_pwa_named() {
  local target="$1" f n
  while IFS= read -r -d '' f; do
    n="$(sed -n 's/^Name=//p' "$f" | head -1)"
    [[ "$n" == "$target" ]] && return 0
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -name 'chrome-*.desktop' -print0 2>/dev/null)
  return 1
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && show_help

# --- Collect target app names ---
APP_NAMES=()

# --- Discover managed and legacy web apps (entries the plugin also owns) ---
if (( $# == 0 )); then
  WEB_APPS=()
  while IFS= read -r -d '' file; do
    if grep -q '^X-Webappbar-Id=' "$file" || grep -q '^Exec=.*webapp-launch' "$file"; then
      WEB_APPS+=("$(basename "${file%.desktop}")")
    fi
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)

  if (( ${#WEB_APPS[@]} == 0 )); then
    warn "No web apps to remove."
    exit 0
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    error "fzf not found. Pass app name(s) explicitly: webapp-remove <name>..."
    exit 1
  fi

  # Multi-select with TAB; ESC/empty cancels.
  IFS=$'\n' read -r -d '' -a APP_NAMES < <(
    printf '%s\n' "${WEB_APPS[@]}" | sort |
      fzf --multi --prompt "Remove web app(s)> " --header "TAB to select, ENTER to confirm" &&
      printf '\0'
  ) || true
else
  APP_NAMES=("$@")
fi

if (( ${#APP_NAMES[@]} == 0 )); then
  warn "Nothing selected. Aborted."
  exit 0
fi

# --- Remove each selected app (script-managed only; Chrome PWAs are read-only) ---
for APP_NAME in "${APP_NAMES[@]}"; do
  [[ -z "$APP_NAME" ]] && continue
  if [[ "$APP_NAME" == .* || "$APP_NAME" == */* || "$APP_NAME" == *\\* || "$APP_NAME" =~ [[:cntrl:]] ]]; then
    warn "No web app named '$APP_NAME' found."
    continue
  fi
  target_file="$DESKTOP_DIR/$APP_NAME.desktop"
  if [[ -f "$target_file" ]] &&
    { grep -q '^X-Webappbar-Id=' "$target_file" || grep -q '^Exec=.*webapp-launch' "$target_file"; }; then
    rm -f "$target_file"
    rm -f "$ICON_DIR/$APP_NAME.png"
    ok "Removed $APP_NAME"
  elif chrome_pwa_named "$APP_NAME"; then
    warn "'$APP_NAME' is a Chrome PWA. Remove it in chrome://apps (right-click -> Remove)."
  else
    warn "No web app named '$APP_NAME' found."
  fi
done

update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
