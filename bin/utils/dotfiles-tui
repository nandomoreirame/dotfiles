#!/usr/bin/env bash
# dotfiles-tui - guided installer for the dotfiles, run as `dotfiles tui`.
#
# Screen 1 checks the prerequisites: base tools (git, curl, sudo, base-devel,
# an AUR helper) and pending system updates. The install checklist (screen 2)
# stays locked until both are clean. Only the sudo prompt runs outside the TUI
# (`sudo -v`, once per run). The steps then run in the background, and screen 3
# shows their status and a live tail of the log in ~/.cache/dotfiles/.
#
# Built on tui.sh (lib/vendor/tuish, ISC). Its compat.sh turns on `set -euf`
# and pins LC_ALL=C, so it is loaded only in this process, never by lib/.

usage() {
  cat <<'EOF'
Usage: dotfiles tui

Interactive installer. Checks the base tools and pending system updates, then
offers a checklist of install steps (packages per manager, fonts, runtimes,
links, setup) that run through the dotfiles CLI.

Keys: arrows or j/k move, space selects, enter confirms, q quits.
For scripts and CI use 'dotfiles install' instead.
EOF
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  "") ;;
  *) printf "error: unexpected argument '%s'\n\n" "$1" >&2; usage >&2; exit 2 ;;
esac

if [ ! -t 0 ] || [ ! -t 1 ]; then
  printf '%s\n' "error: dotfiles tui needs a terminal; in scripts use 'dotfiles install'" >&2
  exit 2
fi

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
: "${DOTFILES_TUI_CLI:=$ROOT/bin/dotfiles}"
export DOTFILES_TUI_CLI

# Remember the caller's locale: commands run outside the TUI get it back.
_tui_orig_lc_all="${LC_ALL-__unset__}"

# shellcheck source=lib/tui-model.sh
. "$ROOT/lib/tui-model.sh"
_tuish_src="$ROOT/lib/vendor/tuish/src"
for _mod in compat ord tui term event hid viewport keybind; do
  # shellcheck disable=SC1090
  . "$_tuish_src/$_mod.sh"
done
unset _mod

# ---- state -------------------------------------------------------------------

_screen=prereq    # prereq | checklist | running
_action=""        # what the finished TUI session asks the main loop to do
_missing=""       # newline-separated missing base items
_pending=""       # pending update count, or "error"
_cursor=1
_drawn=0          # first idle draws once; keys and resize redraw on their own
_step_ids=()
_step_labels=()
_selected=()
# Background run: ids and labels shown on the running screen, the files the
# runner writes, its pid and the sudo keepalive pid.
_run_ids=()
_run_labels=()
_run_state=""
_run_log=""
_run_pid=""
_keepalive_pid=""
_run_back=checklist   # screen to return to when the run is over
_spin=0

_load_steps() {
  local line
  while IFS= read -r line; do
    _step_ids+=("${line%%|*}")
    _step_labels+=("${line#*|}")
    _selected+=(0)
  done <<EOF
$(_tui_steps)
EOF
}

_refresh_prereqs() {
  printf '%s\n' "Checking the base tools and pending updates..."
  _missing="$(_tui_base_missing)"
  _pending="$(_tui_pending_updates)" || _pending=error
}

_gate_open() { [ -z "$_missing" ] && [ "$_pending" = 0 ]; }

_selected_ids() {
  local i
  for i in "${!_step_ids[@]}"; do
    [ "${_selected[$i]}" = 1 ] && printf '%s\n' "${_step_ids[$i]}"
  done
  return 0
}

# ---- drawing -----------------------------------------------------------------

_title() {
  tuish_clear_screen
  tuish_reverse
  tuish_clear_to_edge 1
  tuish_vmove 1 1
  tuish_print " dotfiles tui: $1 "
  tuish_sgr_reset
}

# _status_row <row> <ok:0|1> <label>
_status_row() {
  if [ "$2" = 1 ]; then
    tuish_text "$1" 3 "[ok]" fg=2
  else
    tuish_text "$1" 3 "[!!]" fg=1
  fi
  tuish_text "$1" 9 "$3"
}

_render_prereq() {
  local row=3 item ok
  _title "Prerequisites"
  tuish_text "$row" 2 "Base tools" fg=6
  for item in git curl sudo base-devel aur-helper; do
    row=$((row + 1))
    ok=1
    case $'\n'"$_missing"$'\n' in *$'\n'"$item"$'\n'*) ok=0 ;; esac
    case "$item" in
      aur-helper) _status_row "$row" "$ok" "AUR helper (yay or paru)" ;;
      *) _status_row "$row" "$ok" "$item" ;;
    esac
  done
  row=$((row + 2))
  tuish_text "$row" 2 "System updates" fg=6
  row=$((row + 1))
  case "$_pending" in
    0) _status_row "$row" 1 "up to date" ;;
    error) _status_row "$row" 0 "could not check (offline or no pacman database?)" ;;
    1) _status_row "$row" 0 "1 pending update" ;;
    *) _status_row "$row" 0 "$_pending pending updates" ;;
  esac
  row=$((row + 2))
  if _gate_open; then
    tuish_text "$row" 2 "Ready. Press enter for the install checklist." fg=2
  else
    tuish_text "$row" 2 "The install checklist unlocks when everything above is ok." fg=3
  fi
  local keys="r recheck   q quit"
  [ -n "$_missing" ] && keys="i install missing   $keys"
  case "$_pending" in 0 | error) ;; *) keys="u update system   $keys" ;; esac
  _gate_open && keys="enter continue   $keys"
  tuish_text $((row + 2)) 2 "$keys" fg=8
}

_render_checklist() {
  local i row mark
  _title "Install checklist"
  for i in "${!_step_ids[@]}"; do
    row=$((i + 3))
    mark="[ ]"
    [ "${_selected[$i]}" = 1 ] && mark="[x]"
    if [ $((i + 1)) -eq "$_cursor" ]; then
      tuish_reverse
      tuish_text "$row" 2 " $mark ${_step_labels[$i]} "
      tuish_sgr_reset
    else
      tuish_text "$row" 2 " $mark ${_step_labels[$i]} "
    fi
  done
  row=$((${#_step_ids[@]} + 4))
  tuish_text "$row" 2 "space select   a all/none   enter run selected   b back   q quit" fg=8
}

# _line <row> <text> [fg=N]: clear the row, then print from column 3. Redraws
# in place, so the running screen updates every tick without a full clear.
_line() {
  local row="$1"
  shift
  tuish_clear_to_edge "$row"
  [ -n "${1:-}" ] && tuish_text "$row" 3 "$@"
  return 0
}

_render_running() {
  local i row status frames="|/-\\" done_now=0 failed="" width pane_top pane_rows line
  [ "$_drawn" = 1 ] || _title "Installing"
  _tui_runner_done "$_run_state" && done_now=1
  _spin=$(((_spin + 1) % 4))
  for i in "${!_run_ids[@]}"; do
    row=$((i + 3))
    status="$(_tui_step_status "$_run_state" "${_run_ids[$i]}")"
    case "$status" in
      ok) _line "$row" "[ok]" fg=2 ;;
      failed) _line "$row" "[!!]" fg=1; failed="${failed:+$failed }${_run_ids[$i]}" ;;
      running) _line "$row" "[ ${frames:$_spin:1}]" fg=3 ;;
      *) _line "$row" "[  ]" fg=8 ;;
    esac
    tuish_text "$row" 8 "${_run_labels[$i]}"
  done
  row=$((${#_run_ids[@]} + 4))
  _line "$row" "Output" fg=6
  width=$((TUISH_COLUMNS - 4))
  [ "$width" -gt 10 ] || width=10
  pane_top=$((row + 1))
  pane_rows=$((TUISH_LINES - pane_top - 3))
  [ "$pane_rows" -gt 3 ] || pane_rows=3
  i=0
  while IFS= read -r line; do
    _line $((pane_top + i)) "$line" fg=8
    i=$((i + 1))
  done <<EOF
$(_tui_log_tail "$_run_log" "$pane_rows" "$width")
EOF
  while [ "$i" -lt "$pane_rows" ]; do _line $((pane_top + i)) ""; i=$((i + 1)); done
  row=$((pane_top + pane_rows + 1))
  if [ "$done_now" = 0 ]; then
    _line "$row" "Installing...   ctrl-c stop" fg=3
  elif [ -z "$failed" ]; then
    _line "$row" "All steps finished." fg=2
  else
    _line "$row" "Failed: $failed" fg=1
  fi
  _line $((row + 1)) "log: $_run_log" fg=8
  if [ "$done_now" = 1 ]; then
    _line $((row + 2)) "enter back   q quit" fg=8
  else
    _line $((row + 2)) ""
  fi
}

_render() {
  case "$_screen" in
    prereq) _render_prereq ;;
    checklist) _render_checklist ;;
    running) _render_running ;;
  esac
}

# ---- keys --------------------------------------------------------------------

_finish() {
  _action="$1"
  tuish_quit
}

_on_key_prereq() {
  case "$TUISH_EVENT" in
    "char q" | esc) _finish quit ;;
    "char r") _finish recheck ;;
    "char i") [ -n "$_missing" ] && _finish install-base ;;
    "char u") case "$_pending" in 0 | error) ;; *) _finish update ;; esac ;;
    enter) _gate_open && _finish checklist ;;
  esac
  return 0
}

_on_key_checklist() {
  local total=${#_step_ids[@]} i all=1
  case "$TUISH_EVENT" in
    "char q") _finish quit ;;
    "char b" | esc) _finish back ;;
    up | "char k") [ "$_cursor" -gt 1 ] && _cursor=$((_cursor - 1)); _render ;;
    down | "char j") [ "$_cursor" -lt "$total" ] && _cursor=$((_cursor + 1)); _render ;;
    space)
      i=$((_cursor - 1))
      if [ "${_selected[$i]}" = 1 ]; then _selected[i]=0; else _selected[i]=1; fi
      _render
      ;;
    "char a")
      for i in "${!_selected[@]}"; do [ "${_selected[$i]}" = 1 ] || all=0; done
      for i in "${!_selected[@]}"; do _selected[i]=$((1 - all)); done
      _render
      ;;
    enter) [ -n "$(_selected_ids)" ] && _finish run ;;
  esac
  return 0
}

_on_key_running() {
  _tui_runner_done "$_run_state" || return 0
  case "$TUISH_EVENT" in
    enter | "char b" | esc) _finish run-back ;;
    "char q") _finish quit ;;
  esac
  return 0
}

_on_key() {
  case "$TUISH_EVENT" in
    idle)
      # The running screen follows the background run on every tick.
      if [ "$_screen" = running ]; then
        _render; _drawn=1
        _tui_runner_done "$_run_state" && _stop_keepalive
      elif [ "$_drawn" != 1 ]; then
        _render; _drawn=1
      fi
      return 0
      ;;
    resize) _drawn=0; _render; _drawn=1; return 0 ;;
    ctrl-c)
      [ "$_screen" = running ] && _stop_run
      _finish quit
      return 0
      ;;
  esac
  case "$_screen" in
    prereq) _on_key_prereq ;;
    checklist) _on_key_checklist ;;
    running) _on_key_running ;;
  esac
}

# ---- outside the TUI -----------------------------------------------------------

# _outside <command...>: run with the caller's locale in the normal terminal.
_outside() {
  if [ "$_tui_orig_lc_all" = __unset__ ]; then
    env -u LC_ALL "$@"
  else
    LC_ALL="$_tui_orig_lc_all" "$@"
  fi
}

_pause() {
  printf '\n%s' "Press enter to return to dotfiles tui. "
  read -r _ || :
}

# ---- background runs -----------------------------------------------------------

# _unlock_sudo: ask for the sudo password once, in the normal terminal. The
# background run cannot prompt inside the TUI.
_unlock_sudo() {
  printf '%s\n' "dotfiles tui needs sudo for this install."
  _outside sudo -v
}

_start_keepalive() {
  # Refresh the sudo timestamp while the run lasts, so long steps never prompt.
  (
    while kill -0 "$_run_pid" 2>/dev/null; do
      sudo -n true 2>/dev/null || :
      sleep 50
    done
  ) &
  _keepalive_pid=$!
}

_stop_keepalive() {
  [ -n "$_keepalive_pid" ] || return 0
  kill "$_keepalive_pid" 2>/dev/null || :
  _keepalive_pid=""
}

# _stop_run: ctrl-c during a run stops the runner and its children.
_stop_run() {
  [ -n "$_run_pid" ] || return 0
  pkill -TERM -P "$_run_pid" 2>/dev/null || :
  kill "$_run_pid" 2>/dev/null || :
  _stop_keepalive
}

_new_run_files() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  mkdir -p "$dir"
  _run_log="$dir/tui-$(date +%Y%m%d-%H%M%S).log"
  _run_state="$_run_log.state"
  : >"$_run_log"
  : >"$_run_state"
}

# Runner subshells get the caller's locale back (compat.sh pinned LC_ALL=C).
_restore_locale() {
  if [ "$_tui_orig_lc_all" = __unset__ ]; then unset LC_ALL; else export LC_ALL="$_tui_orig_lc_all"; fi
}

# _start_steps <id...>: the checklist steps in the background.
_start_steps() {
  local i id
  _run_ids=("$@")
  _run_labels=()
  for id in "$@"; do
    for i in "${!_step_ids[@]}"; do
      [ "${_step_ids[$i]}" = "$id" ] && _run_labels+=("${_step_labels[$i]}")
    done
  done
  _new_run_files
  ( _restore_locale; _tui_run_logged "$_run_state" "$_run_log" "${_run_ids[@]}" ) &
  _run_pid=$!
  _start_keepalive
}

# _start_cmd <id> <label> <command...>: one raw command in the background.
_start_cmd() {
  _run_ids=("$1")
  _run_labels=("$2")
  shift 2
  _new_run_files
  ( _restore_locale; _tui_run_logged_cmd "$_run_state" "$_run_log" "${_run_ids[0]}" "$@" ) &
  _run_pid=$!
  _start_keepalive
}

_start_base_install() {
  local pkgs aur=0
  # shellcheck disable=SC2086 # one argument per missing item
  pkgs="$(_tui_base_packages $_missing)"
  case $'\n'"$_missing"$'\n' in *$'\n'aur-helper$'\n'*) aur=1 ;; esac
  # Same rule as the installer: upgrade and install together, never a partial
  # upgrade. --noconfirm because the background run has no terminal to ask.
  # shellcheck disable=SC2016 # $1..$3 expand in the child bash, not here
  _start_cmd base "Base tools" bash -c '
    set -e
    [ -z "$2" ] || sudo pacman -Syu --needed --noconfirm $2
    if [ "$3" = 1 ]; then . "$1/lib/install.sh"; DOTFILES_YES=1 _install_step_aur_helper; fi
  ' _ "$ROOT" "$pkgs" "$aur"
}

_selected_array() {
  local id
  _sel=()
  while IFS= read -r id; do
    [ -n "$id" ] && _sel+=("$id")
  done <<EOF
$(_selected_ids)
EOF
}

# ---- main loop -------------------------------------------------------------------

_load_steps
_refresh_prereqs
while :; do
  _action=""
  _drawn=0
  tuish_init
  tuish_viewport fullscreen
  # tuish_fini drops the bindings, so every session binds again after init.
  tuish_bind '*' '_on_key'
  tuish_run || :
  tuish_fini
  case "$_action" in
    "" | quit) break ;;
    recheck) _refresh_prereqs ;;
    checklist) _screen=checklist ;;
    back) _screen=prereq ;;
    install-base | update | run)
      if ! _unlock_sudo; then
        _pause
        continue
      fi
      case "$_action" in
        install-base) _start_base_install; _run_back=prereq ;;
        update) _start_cmd update "System update (pacman -Syu)" sudo pacman -Syu --noconfirm; _run_back=prereq ;;
        run) _selected_array; _start_steps "${_sel[@]}"; _run_back=checklist ;;
      esac
      _screen=running
      ;;
    run-back)
      _screen="$_run_back"
      [ "$_screen" = prereq ] && _refresh_prereqs
      ;;
  esac
done
