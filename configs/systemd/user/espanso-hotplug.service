[Unit]
Description=Restart espanso after a keyboard is plugged in
Documentation=man:espanso(1)

[Service]
Type=oneshot
# Let every event node of the new keyboard show up before restarting.
# The user manager does not inherit the shell PATH, so the helper is called
# by absolute path: link it into ~/.local/bin (see bin/README.md).
ExecStartPre=/usr/bin/sleep 2
ExecStart=%h/.local/bin/espanso-hotplug
