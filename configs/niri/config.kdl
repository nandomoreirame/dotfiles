// Include monitor configuration generated by nwg-displays
include "monitor.kdl"

// ============================================================
// Niri config (scrollable-tiling Wayland compositor)
// Symlinked to ~/.config/niri/config.kdl by the dotfiles linker.
// Pairs with the Noctalia shell (bar, launcher, OSD, lock, wallpaper).
// Docs: https://yalter.github.io/niri/  |  https://docs.noctalia.dev
// ============================================================

// ---------- Environment ----------
// SDDM launches niri without a login shell, so /etc/profile.d/flatpak.sh
// never runs and XDG_DATA_DIRS is empty. Declare it here so niri propagates
// the Flatpak export dirs to every spawned child (including the Noctalia
// shell); otherwise Flatpak apps never show up in the launcher.
environment {
    XDG_DATA_DIRS "/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"

    // Input method (fcitx5). Since GTK 4.20 the toolkit no longer composes
    // dead keys / compose sequences itself on Wayland when no IME is present;
    // it now relies on the compositor's text-input protocol. Without an IME,
    // GTK4 apps (Ghostty) drop dead keys entirely. Routing GTK/Qt/XWayland
    // apps through fcitx5 restores compose and makes the pt_BR override
    // (dead_acute + c = ç) work everywhere, including Electron (Slack).
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
}

// ---------- Input ----------
// Keyboard: us,br layouts (intl variant on us),
// compose key on Caps, layout toggle on Alt+Space (us-intl <-> pt_BR).
input {
    keyboard {
        xkb {
            layout "us,br"
            variant "intl,"
            // Layout switching (Alt+Space) lives in fcitx5: configs/fcitx5/config
            options "compose:caps"
        }
        repeat-delay 600
        repeat-rate 40
        numlock
    }

    touchpad {
        tap
        dwt
        scroll-factor 0.4
        // natural-scroll is intentionally OFF.
    }

    mouse {
        accel-profile "flat"
    }

    // Uncomment to focus windows/outputs by moving the mouse into them.
    // focus-follows-mouse max-scroll-amount="0%"
}

// ---------- Outputs ----------
// Physical outputs live in monitor.kdl (included above). The public file
// ships a commented example plus one active eDP-1; the private overlay
// replaces monitor.kdl with the machine-specific layout.

// ---------- Layout ----------
layout {
    gaps 4
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.33333; }

    // Terminal Noir palette (configs/noctalia/palettes/Terminal Noir.json):
    // solid primary amber on the focused window, outline grey on the others,
    // error pink when a window asks for attention.
    focus-ring {
        width 3
        active-color "#f5a623"
        inactive-color "#3f3f46"
        urgent-color "#ffb7b0"
    }

    // Hairline on every window; the amber focus-ring is drawn outside it
    // on the active window.
    border {
        width 1
        active-color "#222226"
        inactive-color "#222226"
        urgent-color "#ffb7b0"
    }

    insert-hint {
        color "#f5a62380"
    }
}

// ---------- Startup ----------
// Noctalia is the whole shell: bar, launcher, notifications, OSD,
// lock screen, idle, wallpaper, dock. No waybar/walker/swaync needed here.
spawn-at-startup "noctalia"
// PolicyKit authentication agent (GUI auth prompts).
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// Solaar (Logitech HID++): must run in background to process the MX Master 3S
// button rules (~/.config/solaar/rules.yaml) that map diverted buttons to
// `niri msg action` via Execute. Hidden window.
spawn-at-startup "solaar" "--window=hide"
// Tray apps (1Password + Slack) are launched by a helper that first waits for
// Noctalia's StatusNotifierWatcher - otherwise they race it on login and lose
// their tray icon (they create the SNI item once and never re-register).
// 1Password also provides the SSH signing agent for git.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-tray-autostart"
// Privacy: auto-enable Noctalia "Do Not Disturb" whenever the screen is being
// shared or recorded. Detects active captures via org.gnome.Mutter.ScreenCast
// (every portal-based screen capture on niri shows up there); restores DND on
// stop without clobbering a DND you turned on by hand.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-dnd-screenshare"
// Nautilus Quick Preview opens as a child of the Nautilus window, so niri
// centers it on that window (bottom-right when Nautilus sits in a side column)
// and ignores default-floating-position. Re-center it on its output on open.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-float-center"
// niri's "Screenshot captured" notification has no actions. Send a clickable
// one on every ScreenshotCaptured event (click opens the image, a button shows
// it in Nautilus); a Noctalia filter hides niri's original.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-screenshot-notify"
// Gaming: silence notifications (Noctalia DND) while RetroArch is the focused
// window, so nothing pops over a fullscreen game; restores DND on unfocus,
// without clobbering a DND set by hand. Focus is the proxy for fullscreen
// (niri exposes no is_fullscreen; RetroArch is forced open-fullscreen anyway).
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-dnd-retroarch"
// Noctalia v5 bar lives on HDMI-A-1 only; when that monitor is unplugged or off,
// this watcher enables it on eDP-1 through the state overrides (bar.toml untouched).
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-bar-autoplace"
// Call-aware: auto-enable Noctalia DND + keep-awake while the microphone is
// actively captured (you're in a call). Complements niri-dnd-screenshare.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-mic-dnd"
// Power: switch the power-profiles-daemon profile on AC<->battery (performance
// on AC, power-saver on battery). A manual choice sticks until next plug/unplug.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-power-autoprofile"
// Keep the screen awake while a long task runs (updates, rsync, ffmpeg, Rust
// builds), then let it idle again. Coordinated with the rest via nocta-hold.
spawn-at-startup "sh" "-c" "~/.dotfiles/bin/utils/niri-keepawake-tasks"
// fcitx5 input method (compose / dead keys for the us-intl + pt_BR layout).
spawn-at-startup "fcitx5"
// --- User apps: autostart DISABLED on purpose. Only Steam + 1Password start on
// login now; the lines below are slashdash-commented (/-) so they are trivial to
// re-enable (drop the /- prefix). Each app still opens on demand from the launcher.
// Spotify (native via spotify-launcher); floats per its window-rule below.
/-spawn-at-startup "spotify-launcher"
// Slack: autostart removed from niri-tray-autostart (see Tray apps note above).
// Obsidian (native binary).
/-spawn-at-startup "obsidian"
// Steam: start minimized to the system tray on login.
spawn-at-startup "steam" "-silent"

prefer-no-csd

// niri can't resolve xdg-user-dir here (only ~ and %strftime), so this is the
// XDG Pictures dir; re-edit if your locale uses a different name.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    // skip-at-startup
}

animations {
    // off
}

// ---------- Workspaces ----------
// Named "scratch" workspace used as a hidden holding area (scratchpad emulation).
// Niri has no minimize/hide; the niri-scratchpad helper toggles a window between
// this workspace and the focused one. Named workspaces MUST be declared here -
// move-window-to-workspace to an undeclared name is a silent no-op.
// Pinned to eDP-1 (laptop panel) so it never goes orphan when external monitors
// disconnect, and stays off the primary monitor's workspace navigation.
workspace "scratch" {
    open-on-output "eDP-1"
}

// ---------- Window rules ----------
// Global: round every window's corners (6px) for a consistent look across
// Chrome/Chromium CSD and the rest of the desktop. Chromium on Wayland ignores
// prefer-no-csd and always draws its own rounded corners, so we round everything
// uniformly instead of fighting it. clip-to-geometry crops window content to the
// rounded geometry (no square bleed in the corners).
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Firefox / Chrome picture-in-picture floats by default.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match title="^Picture-in-Picture$"
    open-floating true
}

// Spotify opens floating (Mod+Shift+S opens it / closes it to the tray). app-id capitalization differs
// by install: flatpak = "spotify", native (spotify-launcher) = "Spotify". Match
// case-insensitively so it works either way.
window-rule {
    match app-id=r#"(?i)^spotify$"#
    open-floating true
}

// Obsidian opens tiled at 1/3 of the screen (Mod+Shift+O shows/hides it through scratch). Native binary, app-id "md.obsidian.Obsidian" (older builds: "obsidian").
window-rule {
    match app-id=r#"^(md\.obsidian\.Obsidian|obsidian)$"#
    default-column-width { proportion 0.33333; }
}

// Discord opens floating (Mod+Shift+D opens it / closes it to the tray). Native package, app-id "discord".
window-rule {
    match app-id=r#"^discord$"#
    open-floating true
}

// LocalSend opens floating (Mod+Shift+L opens it / closes it to the tray). Native package, app-id "localsend".
window-rule {
    match app-id=r#"^localsend$"#
    open-floating true
}

// Browsers, editors, OBS Studio, Luciole and tiled Chrome webapps open at 2/3 of the screen. The webapps that
// float (YouTube, YT Music, X composer) are excluded and keep their own size.
window-rule {
    match app-id=r#"^(google-chrome|chromium|firefox|brave-browser|zen)"#
    // Editors: VS Code ("code"/"com.microsoft.VSCode"), Cursor, Antigravity.
    match app-id=r#"(?i)^(code|com\.microsoft\.VSCode|cursor|antigravity)$"#
    // OBS Studio (native "com.obsproject.Studio" or Flatpak of the same id).
    match app-id=r#"^com\.obsproject\.Studio$"#
    // Luciole file manager (Mod+Shift+F).
    match app-id=r#"^dev\.noctalia\.luciole$"#
    match app-id=r#"^chrome-"#
    exclude app-id=r#"^chrome-(youtube\.com|music\.youtube\.com|x\.com__compose_post)"#
    exclude title="^Picture-in-Picture$"
    default-column-width { proportion 0.66667; }
}

// Chrome webapps (--app) get a per-URL app-id "chrome-<host>__-<profile>". The
// profile suffix is environment-dependent (Default, Profile_1, ...), so match
// host-only - pinning to __-Default misses windows opened under another profile.
// Each floats individually without affecting the normal browser ("google-chrome").
// YouTube (Mod+Shift+Y) and YouTube Music (Mod+Shift+U) float; Claude stays tiled.
window-rule {
    match app-id=r#"^chrome-youtube\.com__-"#
    open-floating true
    default-column-width { proportion 0.66667; }
    default-window-height { proportion 0.8; }
}
window-rule {
    match app-id=r#"^chrome-music\.youtube\.com__-"#
    open-floating true
    default-column-width { proportion 0.66667; }
    default-window-height { proportion 0.8; }
}
// X quick post (Mod+Shift+X): the composer URL gets its own app-id
// ("chrome-x.com__compose_post-<profile>"), so only it floats; the regular
// X.com webapp (x.com/home) stays tiled.
window-rule {
    match app-id=r#"^chrome-x\.com__compose_post-"#
    open-floating true
    default-column-width { fixed 589; }
    default-window-height { fixed 299; }
}


// btop TUI opens floating (Mod+Ctrl+T).
window-rule {
    match app-id=r#"^btop-float$"#
    open-floating true
    default-column-width { fixed 1000; }
}

// 1Password desktop app opens floating (Wayland app-id is lowercase "1password")
window-rule {
    match app-id=r#"^1password$"#
    open-floating true
}

// Steam Big Picture via gamescope (game-mode) opens fullscreen on the focused
// output. gamescope's own -f plus this rule guarantee ONE fullscreen surface
// instead of the mispositioned black window bare Big Picture produces on a
// multi-monitor niri desktop. See bin/utils/game-mode.
window-rule {
    match app-id=r#"^gamescope$"#
    open-fullscreen true
}

// RetroArch always opens in real fullscreen (covers the Noctalia bar + gaps).
// Its internal video_fullscreen on Wayland only sized the tile; the compositor
// rule is what actually makes it fullscreen on niri's scrolling tiling layout.
window-rule {
    match app-id=r#"^com\.libretro\.RetroArch$"#
    open-fullscreen true
}

// Nautilus Quick Preview (GNOME Sushi, triggered by Space) opens floating.
// sushi requests a tiny window under niri (~410px wide) and never grows it to
// the image. We set a generous MIN size, sent at map time - unlike
// default-column-width/default-window-height, which resize the window AFTER it
// maps and left the first image rendered small/cropped until you navigated.
// sushi does scale the image to the window, so it fills this min size. It's a
// fixed base size for all previews (per-image sizing isn't possible with sushi
// under niri). 1200x720 fits the smallest logical output (eDP-1 1536x864 @1.25).
window-rule {
    match app-id=r#"^org\.gnome\.NautilusPreviewer$"#
    open-floating true
    min-width 1200
    min-height 720
    // Only used when sushi opens WITHOUT a parent (e.g. via D-Bus): Nautilus
    // passes its window handle, and niri then centers the preview on Nautilus
    // and ignores this. bin/utils/niri-float-center re-centers it on the output.
    // x=-375 (= -(1200-449)/2) compensates for min-width growing the ~449px
    // request rightward from its top-left.
    default-floating-position x=-375 y=60 relative-to="top"
}

// ---------- Keybinds ----------
// "Mod" = Super on a TTY. Navigation binds follow niri conventions
// (the whole point of trying niri); app binds keep the familiar muscle memory.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ---- Apps (same keys where they don't collide) ----
    Mod+Return       hotkey-overlay-title="Terminal: ghostty" { spawn "ghostty"; }
    Mod+Shift+Return hotkey-overlay-title="Claude Code (ghostty)" { spawn "ghostty" "-e" "claude"; }
    Mod+Shift+B      hotkey-overlay-title="Browser" { spawn "google-chrome-stable"; }
    Mod+Shift+Alt+B  hotkey-overlay-title="Browser (private)" { spawn "google-chrome-stable" "--incognito"; }
    Mod+Shift+F      hotkey-overlay-title="File manager" { spawn "luciole"; }

    // Editors: Cursor -> Super+Shift+E (quit relocated to Ctrl+Alt+Delete only),
    // VS Code -> Super+Shift+I (Super+Shift+V collides with niri float-switch).
    Mod+Shift+E hotkey-overlay-title="Editor (Cursor)" { spawn "cursor"; }
    Mod+Shift+I hotkey-overlay-title="VS Code" { spawn "code"; }

    // Web apps (Chrome app mode). YouTube Music relocated U (M = niri fullscreen).
    Mod+Shift+N hotkey-overlay-title="Notion" { spawn "google-chrome-stable" "--app=https://notion.so"; }
    Mod+Shift+C hotkey-overlay-title="Claude" { spawn "claude-desktop" "--password-store=gnome-libsecret"; }
    Mod+Shift+X hotkey-overlay-title="X: new post (toggle)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle x-post"; }
    // Scratchpad toggles: show/hide the floating window (launches if not running),
    // centered on the focused monitor. See bin/utils/niri-scratchpad.
    Mod+Shift+Y hotkey-overlay-title="YouTube (scratchpad)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle youtube"; }
    Mod+Shift+U hotkey-overlay-title="YouTube Music (scratchpad)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle youtube-music"; }
    Mod+Shift+O hotkey-overlay-title="Obsidian (scratchpad)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle obsidian"; }
    Mod+Shift+D hotkey-overlay-title="Discord (toggle to tray)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle discord"; }
    Mod+Shift+L hotkey-overlay-title="LocalSend (toggle to tray)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle localsend"; }
    Mod+Alt+L   hotkey-overlay-title="LocalSend: send clipboard text" { spawn-sh "~/.dotfiles/bin/utils/localsend-clip phone"; }
    // 1Password quick access (the app's native global shortcut doesn't work under
    // Wayland, so niri captures the key and calls --quick-access).
    Ctrl+Shift+Space hotkey-overlay-title="1Password quick access" { spawn "1password" "--quick-access"; }

    // Spotify toggle: opens it (launches if not running) / closes it to the tray.
    Mod+Shift+S hotkey-overlay-title="Spotify (toggle to tray)" { spawn-sh "~/.dotfiles/bin/utils/niri-scratchpad toggle spotify"; }

    // TUIs / tools
    Mod+Alt+T hotkey-overlay-title="btop" { spawn "ghostty" "--class=btop-float" "-e" "btop"; }

    // Game mode: toggle. Freezes the work-app scopes (app.slice) to free CPU/RAM
    // while keeping Steam/RetroArch/Noctalia live, and powers off the non-focused
    // outputs; toggling again restores. Open Steam yourself first. Also wired to
    // Noctalia's Performance-mode hooks. See bin/utils/game-mode. Escape: TTY -> game-mode off.
    Mod+Alt+G repeat=false hotkey-overlay-title="Game mode (freeze work apps)" { spawn-sh "~/.dotfiles/bin/utils/game-mode toggle"; }


    // DroidCam: connect / disconnect the phone camera headless (droidcam-cli),
    // then open Mini Video Me. See bin/utils/droidcam-ctl.
    Mod+Alt+C hotkey-overlay-title="DroidCam: connect" { spawn-sh "~/.dotfiles/bin/utils/droidcam-ctl start"; }
    Mod+Alt+X hotkey-overlay-title="DroidCam: disconnect" { spawn-sh "~/.dotfiles/bin/utils/droidcam-ctl stop"; }

    // Noctalia shell (launcher / control center / settings) via nocta IPC wrapper.
    Ctrl+Space    hotkey-overlay-title="App launcher" { spawn-sh "~/.dotfiles/bin/utils/nocta launcher"; }
    Mod+D         hotkey-overlay-title="App launcher" { spawn-sh "~/.dotfiles/bin/utils/nocta launcher"; }
    // Clipboard history (Noctalia launcher in clipboard mode; backed by cliphist).
    Mod+Alt+V     hotkey-overlay-title="Clipboard history" { spawn-sh "~/.dotfiles/bin/utils/nocta clipboard"; }
    Ctrl+Mod+V    hotkey-overlay-title="Clipboard history" { spawn-sh "~/.dotfiles/bin/utils/nocta clipboard"; }
    Mod+N         hotkey-overlay-title="Control center" { spawn-sh "~/.dotfiles/bin/utils/nocta control-center"; }
    Mod+Alt+N     hotkey-overlay-title="Control center" { spawn-sh "~/.dotfiles/bin/utils/nocta control-center"; }
    Mod+Comma     hotkey-overlay-title="Noctalia settings" { spawn-sh "~/.dotfiles/bin/utils/nocta settings"; }
    Mod+Alt+Comma hotkey-overlay-title="Noctalia settings" { spawn-sh "~/.dotfiles/bin/utils/nocta settings"; }
    // Desktop widgets: toggle edit mode (drag/reposition the widgets over the wallpaper).
    Mod+Alt+E  hotkey-overlay-title="Edit desktop widgets (Noctalia)" { spawn-sh "~/.dotfiles/bin/utils/nocta widgets-edit"; }
    // Bar: hide/show (IPC, needs the shell alive). Restart: kill + respawn (use when it crashes).
    Mod+Alt+Space   hotkey-overlay-title="Toggle bar (Noctalia)" { spawn-sh "~/.dotfiles/bin/utils/nocta bar-toggle"; }
    Mod+Alt+B       hotkey-overlay-title="Restart shell (Noctalia)" { spawn-sh "~/.dotfiles/bin/utils/noctalia-restart"; }
    // Next wallpaper (random, via Noctalia). Super+Alt+W.
    Mod+Alt+W       hotkey-overlay-title="Next wallpaper (Noctalia)" { spawn-sh "~/.dotfiles/bin/utils/nocta wallpaper-random"; }

    // Lock screen (Noctalia native; swaylock is not installed).
    // Mod+L locks (was focus-column-right); column-right stays on Mod+Right + Super+wheel.
    Mod+L       hotkey-overlay-title="Lock screen" { spawn-sh "~/.dotfiles/bin/utils/nocta lock"; }

    // Close window: Ctrl+Q (muscle memory) + Mod+Q (niri default).
    Ctrl+Q repeat=false { close-window; }
    Mod+Q  repeat=false { close-window; }

    // Overview (zoomed-out workspaces/windows).
    Mod+O repeat=false { toggle-overview; }

    // --- Focus ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    // Mod+H     { focus-column-left; }
    // Mod+J     { focus-window-down; }
    // Mod+K     { focus-window-up; }
    // Mod+L moved to lock screen (see Lock section above).

    // --- Move ---
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    // Switch workspace up/down with wrap-around (first <-> last) via helper script.
    // Move window up/down stays on Mod+Ctrl+J/K.
    Mod+Ctrl+Up    { spawn-sh "~/.dotfiles/bin/utils/niri-workspace-wrap up"; }
    Mod+Ctrl+Down  { spawn-sh "~/.dotfiles/bin/utils/niri-workspace-wrap down"; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // --- Monitors ---
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // --- Workspaces ---
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    // Super + mouse wheel scrolls between columns (not workspaces).
    Mod+WheelScrollDown      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }

    // MX Master 3S extra buttons are handled by Solaar (HID++), NOT niri binds:
    // diverted buttons trigger `niri msg action` via Solaar rules + Execute.
    // gesture -> toggle-overview, forward -> focus-workspace-down,
    // back -> focus-workspace-up. Private overlay: configs/solaar/rules.yaml.

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ---- Workspace switching (muscle memory) ----
    // niri workspaces are vertical: next -> down, prev -> up.
    Mod+Tab       { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Alt+Tab       { focus-workspace-down; }
    Alt+Shift+Tab { focus-workspace-up; }
    Ctrl+Alt+Down  { focus-workspace-down; }
    Ctrl+Alt+Up    { focus-workspace-up; }
    Ctrl+Alt+Right { focus-workspace-down; }
    Ctrl+Alt+Left  { focus-workspace-up; }


    // --- Columns / windows ---
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+F { maximize-column; }
    Mod+Shift+M { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C hotkey-overlay-title="Center column" { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    // --- Volume / brightness via nocta (shows the OSD) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "~/.dotfiles/bin/utils/nocta volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "~/.dotfiles/bin/utils/nocta volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "~/.dotfiles/bin/utils/nocta volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "~/.dotfiles/bin/utils/nocta brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "~/.dotfiles/bin/utils/nocta brightness-down"; }

    // --- Media keys (MPRIS via playerctl) ---
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    // --- Screenshots & screen recording ---
    // PrintScreen variants (kept): area / full screen / focused window.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    // Ctrl+Alt+1..4: video / full screen / window / area.
    Ctrl+Alt+4 hotkey-overlay-title="Screenshot: area" { screenshot; }
    Ctrl+Alt+3 hotkey-overlay-title="Screenshot: window" { screenshot-window; }
    Ctrl+Alt+2 hotkey-overlay-title="Screenshot: full screen" { screenshot-screen; }
    // Screen recording binds live in the private overlay.
    Ctrl+Alt+6 hotkey-overlay-title="Convert last video to GIF" { spawn-sh "~/.dotfiles/bin/utils/video-to-gif"; }

    // --- Session ---
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // quit: Ctrl+Alt+Delete only (Super+Shift+E is now Cursor).
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Alt+P hotkey-overlay-title="Monitor DP-1 on/off" { spawn-sh "~/.dotfiles/bin/utils/niri-output-toggle DP-1"; }
}

// Private overlay replaces this file with personal binds and rules.
include "private.kdl"
