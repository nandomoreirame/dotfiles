// Example monitor layout. Replace this file via the private overlay with your
// machine's outputs (nwg-displays can generate them). One active output keeps
// niri validate happy on a laptop with a single panel.

// output "HDMI-A-1" {
//     mode "1920x1080@60.0"
//     scale 1.0
//     position x=1920 y=0
// }

output "eDP-1" {
    mode "1920x1080@60.0"
    scale 1.0
}
